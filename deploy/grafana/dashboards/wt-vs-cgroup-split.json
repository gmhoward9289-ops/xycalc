  "panels": [
    {
      "title": "Inside memory.max: WT cache, other anon, file page cache",
      "description": "Breakdown of the mongo container's memory charge. The stacked bands are WiredTiger's cache, the rest of mongod's anonymous memory (heap, connections, in-flight sorts), and file-backed page cache charged to this cgroup. Dashed lines: the container limit (memory.max) and the configured WT cache maximum. WiredTiger sizes its cache assuming compressed collection files are served from the file cache next to it; when anon grows and the file band shrinks against the limit, that assumption stops holding. The 'anon beyond WT' series subtracts a single WT series via scalar(), so select one mongo at a time.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "mongodb_wiredtiger_cache_bytes_currently_in_the_cache{instance=~\"$instance\"}",
          "legendFormat": "WT cache (anon)",
          "refId": "A"
        },
        {
          "expr": "clamp_min(container_memory_rss{name=~\"$container\"} - scalar(mongodb_wiredtiger_cache_bytes_currently_in_the_cache{instance=~\"$instance\"}), 0)",
          "legendFormat": "anon beyond WT (heap, other)",
          "refId": "B"
        },
        {
          "expr": "container_memory_cache{name=~\"$container\"}",
          "legendFormat": "file page cache (this cgroup)",
          "refId": "C"
        },
        {
          "expr": "container_spec_memory_limit_bytes{name=~\"$container\"}",
          "legendFormat": "memory.max",
          "refId": "D"
        },
        {
          "expr": "mongodb_wiredtiger_cache_maximum_bytes_configured{instance=~\"$instance\"}",
          "legendFormat": "WT max configured",
          "refId": "E"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 35,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "memory.max"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "WT max configured"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    4,
                    6
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "title": "File pages: active vs inactive",
      "description": "Reclaim order. The kernel drops inactive file pages first; nothing has read them recently, so losing them usually costs nothing. Once the inactive band is exhausted, reclaim starts taking active file pages, which mongod is still reading, and those return later as major faults and disk reads. The working-set line (usage minus inactive file) meets the limit exactly when the cheap-to-reclaim band is gone.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "container_memory_total_active_file_bytes{name=~\"$container\"}",
          "legendFormat": "active file (still hot)",
          "refId": "A"
        },
        {
          "expr": "container_memory_total_inactive_file_bytes{name=~\"$container\"}",
          "legendFormat": "inactive file (reclaim fodder)",
          "refId": "B"
        },
        {
          "expr": "container_memory_working_set_bytes{name=~\"$container\"}",
          "legendFormat": "working set",
          "refId": "C"
        },
        {
          "expr": "container_spec_memory_limit_bytes{name=~\"$container\"}",
          "legendFormat": "memory.max",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "working set"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "memory.max"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "title": "Refault cost: major faults and reads against the throttle",
      "description": "Major faults are file pages re-read from disk after reclaim dropped them; cAdvisor does not export workingset_refault_file, so this rate is the closest available proxy. Compare with device read bytes: this probe's block device is throttled to 8 MiB/s (dashed line), so as re-reads approach that line each additional fault queues behind the throttle and surfaces as query latency. 'WT pages into cache' is the same demand counted from Mongo's side.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "rate(container_memory_failures_total{failure_type=\"pgmajfault\",scope=\"container\",name=~\"$container\"}[1m])",
          "legendFormat": "major faults/s",
          "refId": "A"
        },
        {
          "expr": "rate(container_fs_reads_bytes_total{name=~\"$container\"}[1m])",
          "legendFormat": "device reads B/s",
          "refId": "B"
        },
        {
          "expr": "rate(pages_read_into_cache{instance=~\"$instance\"}[1m])",
          "legendFormat": "WT pages into cache/s",
          "refId": "C"
        },
        {
          "expr": "8388608 + 0 * container_spec_memory_limit_bytes{name=~\"$container\"}",
          "legendFormat": "blkio read throttle (8 MiB/s)",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "device reads B/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "blkio read throttle (8 MiB/s)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "title": "PSI: fraction of time stalled",
      "description": "Linux pressure-stall information for the mongo cgroup, plotted as seconds stalled per second (0 to 1). 'some' means at least one task was blocked on memory or I/O during the interval; 'full' means all of them were. The memory panels explain the mechanism; this one measures how much time it actually costs.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "rate(container_pressure_memory_waiting_seconds_total{name=~\"$container\"}[1m])",
          "legendFormat": "memory some",
          "refId": "A"
        },
        {
          "expr": "rate(container_pressure_memory_stalled_seconds_total{name=~\"$container\"}[1m])",
          "legendFormat": "memory full",
          "refId": "B"
        },
        {
          "expr": "rate(container_pressure_io_waiting_seconds_total{name=~\"$container\"}[1m])",
          "legendFormat": "io some",
          "refId": "C"
        },
        {
          "expr": "rate(container_pressure_io_stalled_seconds_total{name=~\"$container\"}[1m])",
          "legendFormat": "io full",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15
          }
        },
        "overrides": []
      }
    },
    {
      "title": "WT occupancy vs cgroup usage, same 0-100 axis",
      "description": "Two utilization views of the same container. WT occupancy is measured against the WT cache maximum and can sit comfortably under 80% while the container's working set is pinned at memory.max. When the two lines diverge - occupancy moderate, working set near 100 - the shortage is in the cgroup's file cache, not inside WiredTiger, and WT-level metrics alone will not show it. The third line tracks how much of the limit is still file cache.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "mongodb_wiredtiger_cache_occupancy_ratio{instance=~\"$instance\"} * 100",
          "legendFormat": "WT occupancy % of WT max",
          "refId": "A"
        },
        {
          "expr": "container_memory_working_set_bytes{name=~\"$container\"} / clamp_min(container_spec_memory_limit_bytes{name=~\"$container\"}, 1) * 100",
          "legendFormat": "working set % of memory.max",
          "refId": "B"
        },
        {
          "expr": "container_memory_cache{name=~\"$container\"} / clamp_min(container_spec_memory_limit_bytes{name=~\"$container\"}, 1) * 100",
          "legendFormat": "file cache % of memory.max",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Ceiling events: memory.max hits and swap",
      "description": "failcnt counts allocation attempts that hit memory.max. A sustained rate with swap flat means the kernel is absorbing those hits through reclaim; the PSI and refault panels show what that costs. Swap growing means overflow is being written out instead. An OOM kill in memory.events is the end state: anonymous memory could not be reclaimed and the process was killed.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "rate(container_memory_failcnt{name=~\"$container\"}[1m])",
          "legendFormat": "memory.max hits/s",
          "refId": "A"
        },
        {
          "expr": "container_memory_swap{name=~\"$container\"}",
          "legendFormat": "swap bytes",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "swap bytes"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      }
    }
  ],
