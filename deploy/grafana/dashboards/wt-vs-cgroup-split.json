    {
      "title": "File pages: active vs inactive",
      "description": "Reclaim order. The kernel drops inactive file pages first; nothing has read them recently, so losing them usually costs nothing. Once the inactive band is exhausted, reclaim starts taking active file pages, which mongod is still reading, and those return later as major faults and disk reads. The working-set line (usage minus inactive file) meets the limit exactly when the cheap-to-reclaim band is gone.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "container_memory_total_active_file_bytes{name=~\"$container\"}",
          "legendFormat": "active file (still hot)",
          "refId": "A"
        },
        {
          "expr": "container_memory_total_inactive_file_bytes{name=~\"$container\"}",
          "legendFormat": "inactive file (reclaim fodder)",
          "refId": "B"
        },
        {
          "expr": "container_memory_working_set_bytes{name=~\"$container\"}",
          "legendFormat": "working set",
          "refId": "C"
        },
        {
          "expr": "(container_spec_memory_limit_bytes{name=~\"$container\"} > 0)",
          "legendFormat": "memory.max",
          "refId": "D"
        },
        {
          "expr": "node_memory_MemTotal_bytes{machine=~\"$machine\"} unless on() (container_spec_memory_limit_bytes{name=~\"$container\"} > 0)",
          "legendFormat": "host MemTotal (no memory.max set)",
          "refId": "E"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "working set"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "memory.max"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "host MemTotal (no memory.max set)"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      }
