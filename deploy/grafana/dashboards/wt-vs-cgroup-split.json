  "panels": [
    {
      "title": "Inside memory.max: WT cache, other anon, file page cache",
      "description": "Breakdown of the mongo container's memory charge. The stacked bands are WiredTiger's cache, the rest of mongod's anonymous memory (heap, connections, in-flight sorts), and file-backed page cache charged to this cgroup. Dashed lines: the container limit (memory.max) and the configured WT cache maximum. WiredTiger sizes its cache assuming compressed collection files are served from the file cache next to it; when anon grows and the file band shrinks against the limit, that assumption stops holding. The 'anon beyond WT' series subtracts a single WT series via scalar(), so select one mongo at a time. When the container has no memory limit, the memory.max line disappears and a host-MemTotal line takes its place: with no cgroup ceiling, host RAM is the real one.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "mongodb_wiredtiger_cache_bytes_currently_in_the_cache{instance=~\"$instance\"}",
          "legendFormat": "WT cache (anon)",
          "refId": "A"
        },
        {
          "expr": "clamp_min(container_memory_rss{name=~\"$container\"} - scalar(mongodb_wiredtiger_cache_bytes_currently_in_the_cache{instance=~\"$instance\"}), 0)",
          "legendFormat": "anon beyond WT (heap, other)",
          "refId": "B"
        },
        {
          "expr": "container_memory_cache{name=~\"$container\"}",
          "legendFormat": "file page cache (this cgroup)",
          "refId": "C"
        },
        {
          "expr": "(container_spec_memory_limit_bytes{name=~\"$container\"} > 0)",
          "legendFormat": "memory.max",
          "refId": "D"
        },
        {
          "expr": "mongodb_wiredtiger_cache_maximum_bytes_configured{instance=~\"$instance\"}",
          "legendFormat": "WT max configured",
          "refId": "E"
        },
        {
          "expr": "node_memory_MemTotal_bytes{machine=~\"$machine\"} unless on() (container_spec_memory_limit_bytes{name=~\"$container\"} > 0)",
          "legendFormat": "host MemTotal (no memory.max set)",
          "refId": "F"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 35,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "memory.max"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "WT max configured"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    4,
                    6
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "host MemTotal (no memory.max set)"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
