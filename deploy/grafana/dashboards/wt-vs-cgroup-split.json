        "current": { "text": "xycalc-celery-probe-mongo-1", "value": "xycalc-celery-probe-mongo-1" },
        "includeAll": false,
        "multi": false,
        "refresh": 2
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "query": "label_values(mongodb_wiredtiger_cache_bytes_currently_in_the_cache, instance)",
        "current": { "text": "All", "value": ".*" },
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "refresh": 2
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
