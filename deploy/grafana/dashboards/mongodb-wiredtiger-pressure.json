          "refId": "A"
        },
        {
          "expr": "mongodb_wiredtiger_cache_tracked_dirty_bytes_in_the_cache / clamp_min(mongodb_wiredtiger_cache_bytes_currently_in_the_cache, 1) * 100",
          "legendFormat": "dirty %",
          "refId": "B"
        }
      ]
    },
