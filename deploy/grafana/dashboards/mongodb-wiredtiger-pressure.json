  "panels": [
    {
      "title": "Is app-thread eviction sustained?",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "rate(pages_evicted_by_application_threads[1m])",
          "legendFormat": "app-thread eviction/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "title": "Occupancy % vs dirty % (lines at 80/90/95 and 20)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "mongodb_wiredtiger_cache_pages_currently_held_in_the_cache / clamp_min(mongodb_wiredtiger_cache_maximum_pages, 1) * 100",
