{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "xycalc",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "xycalc.api:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8200"
      ],
      "port": 8200
    },
    {
      "name": "xycalc-export",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8231",
        "--directory",
        "dist"
      ],
      "port": 8231
    }
  ]
}
