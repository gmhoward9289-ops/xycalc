#!/bin/sh
# Refuse to push anywhere but swamplink.
#
# This repo is destined for GitHub, but not yet. The guard exists so that
# "not yet" survives muscle memory across three machines and a dozen parallel
# sessions -- `git push` to a remote that was added for some other reason is a
# publication event, and publication should be a decision.
#
# Installed by tools/install-hooks.sh. To publish deliberately:
#
#     XYCALC_ALLOW_PUBLISH=1 git push github main
#
# That is the whole escape hatch. Do not edit this file to get past it -- an
# environment variable typed on purpose is a record of intent; a hook someone
# quietly deleted is not.

remote_url="$2"

if [ -n "$XYCALC_ALLOW_PUBLISH" ]; then
    echo "pre-push: XYCALC_ALLOW_PUBLISH set — allowing push to $remote_url" >&2
    exit 0
fi

# Matches the ssh host alias, which is what the remote is configured with.
# Deliberately does NOT match a raw IP: this file ships in a repo headed for
# GitHub, so putting the server's address in it would be the exact kind of
# leak the pre-commit scan exists to catch -- and it did catch it. A remote
# written as an IP fails closed, which is the safe direction.
case "$remote_url" in
    *swamplink*)
        exit 0
        ;;
esac

cat >&2 <<EOF

  pre-push: refusing to push to
      $remote_url

  xycalc syncs through swamplink only. It is intended to become open source,
  but that has not happened yet, and pushing it somewhere else is how "not
  yet" turns into "already did".

  If you mean it:
      XYCALC_ALLOW_PUBLISH=1 git push $1 <branch>

EOF
exit 1
