#!/bin/sh
# Allow pushes to the two remotes this project actually has. Refuse the rest.
#
# This started life as a "not published yet" guard, back when the repo synced
# through swamplink alone and an accidental push would have been a publication
# event. It was published deliberately on 2026-07-31, so GitHub is now an
# expected destination rather than an accident.
#
# The guard is kept, narrowed rather than deleted, because the failure it
# prevents did not go away: a typo'd or copy-pasted remote silently pushing a
# repo somewhere nobody meant it to go. Two known destinations is a short
# allowlist and a cheap check.
#
# Installed by tools/install-hooks.sh -- .git/hooks is not version controlled
# and does not survive a clone, which is exactly when this matters most.
#
# To push somewhere new on purpose:
#
#     XYCALC_ALLOW_PUBLISH=1 git push <remote> <branch>
#
# An environment variable typed on purpose is a record of intent. A hook
# someone quietly deleted is not -- so add the destination here rather than
# reaching for the escape hatch twice.

remote_url="$2"

if [ -n "$XYCALC_ALLOW_PUBLISH" ]; then
    echo "pre-push: XYCALC_ALLOW_PUBLISH set — allowing push to $remote_url" >&2
    exit 0
fi

# Matches the ssh host alias and the published repo. Deliberately does NOT
# match a raw IP: this file ships in a public repo, so putting the server's
# address in it would be the exact leak the pre-commit scan exists to catch --
# and it did catch it, on the first commit. A remote written as a bare IP
# fails closed, which is the safe direction.
case "$remote_url" in
    *swamplink*|*github.com*xycalc*|*github.com:*xycalc*)
        exit 0
        ;;
esac

cat >&2 <<EOF

  pre-push: refusing to push to
      $remote_url

  xycalc pushes to swamplink (origin) and to its own GitHub repo. Anywhere
  else is more likely a typo than a decision.

  If you mean it:
      XYCALC_ALLOW_PUBLISH=1 git push $1 <branch>

  If you mean it more than once, add the destination to tools/pre-push.

EOF
exit 1
